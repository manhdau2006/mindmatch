PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindmatch
# dev: client gửi thẳng userId để test | token: bắt buộc gửi token đăng nhập
AUTH_MODE=dev
# Các origin được phép gọi API, cách nhau bằng dấu phẩy. Để trống = cho phép tất cả
CORS_ORIGINS=
PAYMENT_MODE=local
HOLD_SECONDS=600
# Giữ lịch định kỳ chờ gia sư, tối đa đến buổi đầu tiên
REQUEST_HOLD_HOURS=24
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FIREBASE_PROJECT_ID=
# Đường dẫn service account, dùng khi AUTH_MODE=token. Giữ file ngoài Git.
GOOGLE_APPLICATION_CREDENTIALS=
