generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  student
  tutor
  admin
}

enum ConversationStatus {
  active
  closed
}

enum MessageType {
  text
  image
  system
}

// Bảng users tối giản để chat chạy được — phần Xác thực (Nguyên) bổ sung thêm cột.
model User {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  role         Role      @default(student)
  avatar       String?
  isBanned     Boolean   @default(false)
  lastActiveAt DateTime?
  createdAt    DateTime  @default(now())
  firebaseUid  String?   @unique

  studentMatches Match[] @relation("StudentMatches")
  tutorMatches Match[] @relation("TutorMatches")
  slots TutorSlot[]
  weeklySchedule WeeklySchedule?
  withdrawals Withdrawal[]
  paidTransactions Transaction[] @relation("TransactionPayer")

  studentConversations Conversation[] @relation("StudentConversations")
  tutorConversations   Conversation[] @relation("TutorConversations")
  messages             Message[]

  @@map("users")
}

enum BookingKind {
  single_session
  recurring_class
}

enum PaymentPurpose {
  lesson_deposit
  class_acceptance
}

enum BookingStatus {
  pending_tutor
  rejected
  held
  confirmed
  expired
  cancelled
  completed
}

enum PaymentStatus {
  cancelled
  pending
  succeeded
  failed
  refund_required
  refunded
}

enum WithdrawalStatus {
  requested
  approved
  paid
  rejected
}

model Match {
  id Int @id @default(autoincrement())
  studentId Int
  tutorId Int
  active Boolean @default(true)
  source String @default("team")
  student User @relation("StudentMatches", fields: [studentId], references: [id])
  tutor User @relation("TutorMatches", fields: [tutorId], references: [id])
  bookings Booking[]
  @@unique([studentId, tutorId])
  @@map("matches")
}

model WeeklySchedule {
  userId Int @id
  weekdays Int[]
  sessionsPerWeek Int
  startTime String
  endTime String
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weekly_schedules")
}

model TutorSlot {
  id Int @id @default(autoincrement())
  tutorId Int
  startsAt DateTime
  endsAt DateTime
  price Int
  tutor User @relation(fields: [tutorId], references: [id])
  bookings Booking[]
  @@unique([tutorId, startsAt])
  @@map("tutor_slots")
}

model Booking {
  id String @id @default(uuid())
  matchId Int
  slotId Int?
  kind BookingKind @default(single_session)
  recurrenceWeekdays Int[] @default([])
  recurrenceStart DateTime? @db.Date
  recurrenceEnd DateTime? @db.Date
  startTime String?
  endTime String?
  timeZone String @default("Asia/Ho_Chi_Minh")
  rejectionReason String?
  confirmedAt DateTime?
  status BookingStatus @default(held)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  match Match @relation(fields: [matchId], references: [id])
  slot TutorSlot? @relation(fields: [slotId], references: [id])
  transaction Transaction?
  @@index([status, expiresAt])
  @@map("bookings")
}

model Transaction {
  id String @id @default(uuid())
  bookingId String @unique
  purpose PaymentPurpose @default(lesson_deposit)
  payerId Int?
  payer User? @relation("TransactionPayer", fields: [payerId], references: [id], onDelete: SetNull)
  amount Int
  currency String @default("vnd")
  commissionBps Int
  commission Int
  tutorIncome Int
  provider String
  sessionId String? @unique
  status PaymentStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id])
  events PaymentEvent[]
  @@index([payerId])
  @@map("transactions")
}

model PaymentEvent {
  id String @id
  transactionId String
  outcome String
  createdAt DateTime @default(now())
  transaction Transaction @relation(fields: [transactionId], references: [id])
  @@map("payment_events")
}

model Withdrawal {
  id String @id @default(uuid())
  tutorId Int
  amount Int
  destination String
  status WithdrawalStatus @default(requested)
  handledBy Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tutor User @relation(fields: [tutorId], references: [id])
  @@index([tutorId, status])
  @@map("withdrawals")
}

model PaymentConfig {
  id Int @id @default(1)
  commissionBps Int @default(1000)
  acceptanceFeeVnd Int @default(100000)
  updatedAt DateTime @updatedAt
  updatedBy Int?
  @@map("payment_config")
}

model Conversation {
  id        Int                @id @default(autoincrement())
  studentId Int
  tutorId   Int
  status    ConversationStatus @default(active)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  student  User      @relation("StudentConversations", fields: [studentId], references: [id])
  tutor    User      @relation("TutorConversations", fields: [tutorId], references: [id])
  messages Message[]

  @@unique([studentId, tutorId])
  @@index([tutorId])
  @@map("conversations")
}

model Message {
  id             Int         @id @default(autoincrement())
  conversationId Int
  senderId       Int
  content        String
  messageType    MessageType @default(text)
  isRead         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, id])
  @@map("messages")
}
